# Root .env — consumed by Docker Compose for infrastructure secrets.
# Copy to `.env` (gitignored). Keep in sync with backend/laravel/.env,
# which holds the application/LLM configuration.
#
# Dev (docker-compose.yml) has safe defaults; production (docker-compose.prod.yml)
# refuses to start unless these are set.

MYSQL_DATABASE=knowledgebase
MYSQL_USER=knowledgebase
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Required in production: Redis AUTH and Qdrant api-key. The backend .env must
# carry the same values (REDIS_PASSWORD, QDRANT_API_KEY).
REDIS_PASSWORD=change-me
QDRANT_API_KEY=change-me

# Host port for the production frontend (default 80).
HTTP_PORT=80
