# Optional: terminate TLS directly on the Laravel origin (4.6).
#
# Usage:
#   1. Put fullchain.pem + privkey.pem in docker/certs/
#   2. Mount them in the nginx service and use this file as the server config
#      (docker-compose.prod.yml has commented lines for both).
#   3. Set APP_URL / OPENROUTER_APP_URL to the https:// origin and
#      TRUSTED_PROXIES to the proxy CIDR (or "*" when nginx is the edge).
#
# Most deployments terminate TLS at a load balancer and use prod.conf instead;
# the frontend nginx always emits HSTS so browsers upgrade once TLS is in front.

server {
    listen 80;
    server_name kb.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name kb.example.com;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /var/www/html/laravel/public;
    index index.php;
    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass app:9000;
        fastcgi_read_timeout 3600s;
        fastcgi_buffering off;
    }
}
